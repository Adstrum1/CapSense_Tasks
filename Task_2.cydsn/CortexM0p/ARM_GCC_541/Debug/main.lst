 164:main.c        ****         {
 165:main.c        ****             buttonEvent = 0;
 166:main.c        ****             break;
 167:main.c        ****         }
 168:main.c        **** 
 169:main.c        ****         if (CapSenseFinish() && CapSense_IsAnyWidgetActive())
 170:main.c        ****         {
 171:main.c        ****             break;
 172:main.c        ****         }
